{% extends 'site/layout.html.twig' %}
{% block title %}{{ domain.title }} — Physique objets{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('learning_domains') }}">Domaines</a> / {{ domain.title }}</nav>
<header class="page-heading"><p class="eyebrow">{{ domain.cards|length }} fiches web</p><h1>{{ domain.title }}</h1><p class="lead">{{ domain.summary }}</p><p>{{ domain.scope }}</p><p class="pilot-status">Version pilote · relecture scientifique par l’auteur à faire</p></header>
{% if domain.loops %}
{% if domain.loops|length > 1 %}<nav class="base-switcher" aria-label="Choisir une boucle du domaine">{% for group in domain.loops %}<a href="#{{ group.anchor }}">{{ group.title }}</a>{% endfor %}<a href="#fiches-domaine">Toutes les fiches</a></nav>{% endif %}
{% for group in domain.loops %}<section class="interactive-loop domain-loop" aria-labelledby="{{ group.anchor }}"><div class="loop-toolbar"><h2 id="{{ group.anchor }}">{{ group.title }}</h2><a href="{{ path('sitephys_physmvc_home') }}">Revenir à la boucle générale</a></div>
{% include 'site/_loop.html.twig' with {steps: group.steps, tip_prefix: group.anchor ~ '-tip-', marker_id: group.anchor ~ '-arrow', board_label: group.title, evaluation_href: group.steps[3].href} only %}
<p class="loop-help">Chaque étape ouvre une section de fiche. Survolez ou utilisez Tab pour lire l’explication ; sur mobile, touchez « i ». Échap ferme l’info-bulle.</p></section>
{% endfor %}
{% else %}<p><a class="primary-link" href="{{ path('learning_subloop', {base: 1}) }}">Explorer les 36 sous-étapes du parcours</a></p>{% endif %}
<section class="domain-reading" aria-labelledby="fiches-domaine"><h2 id="fiches-domaine">Lire les fiches du domaine</h2><div class="topic-grid learning-grid">
{% for card in domain.cards %}<a class="topic-card" href="{{ path('learning_card', {slug: card.slug}) }}"><span class="eyebrow">{{ '%02d'|format(card.number) }} · {{ card.level }}</span><h3>{{ card.title }}</h3><p>{{ card.summary }}</p>{% if analyses[card.slug].refinement is defined %}<span class="analysis-refinement-badge">Entrées et évaluations précisées</span>{% endif %}</a>{% endfor %}
</div></section>
<p><a href="{{ path('learning_corrections') }}">Consulter les corrections documentées</a> · <a href="{{ path('source_index') }}">Retrouver les sources dans les recueils</a></p>
{% endblock %}
