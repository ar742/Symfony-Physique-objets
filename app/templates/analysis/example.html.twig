{% extends 'site/layout.html.twig' %}
{% block title %}{{ example.title }} — {{ format.shape }}{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('sitephys_physmvc_home') }}">Formes d’analyse</a> / <a href="{{ path('analysis_format', {format:format.id}) }}">{{ format.id|replace({'cas-':'Cas '}) }} · {{ format.shape }}</a> / Exemple</nav>
<header class="page-heading"><p class="eyebrow">{{ format.id|replace({'cas-':'Cas '}) }} · {{ format.shape }}{% if example.variant is defined %} · Variante {{ example.variant }}{% endif %}</p><h1>{{ example.title }}</h1><p class="lead">{{ example.question }}</p><p class="pilot-status">Analyse évolutive · à préciser avec l’auteur</p></header>
<section class="analysis-subject"><p><strong>Périmètre :</strong> {{ example.scope }}</p><p><strong>Statut des données :</strong> {{ example.basis }}</p></section>
<dl class="analysis-io"><div><dt>Attributs d’entrée</dt><dd>{{ example.attributes.input }}</dd></div><div><dt>Attributs de sortie</dt><dd>{{ example.attributes.output }}</dd></div></dl><p>{{ example.attributes.comparison }}</p>
<section class="interactive-loop analysis-loop" aria-labelledby="schema"><h2 id="schema">{{ format.width }} systèmes{% if format.depth == 2 %}, chacun en trois sous-systèmes{% else %}, sans sous-niveaux{% endif %}</h2>
{% include 'analysis/_board.html.twig' with {steps:example.levels,board_label:example.title,prefix:'exemple',evaluation_href:'#comparaisons',comparison_links:format.width == 6 ? [{href:'#point-6.0',label:'6.0 ↔ 1.0 · Exp.'},{href:'#point-5.0',label:'5.0 ↔ 2.0 · TH'},{href:'#point-4.0',label:'4.0 ↔ 3.0 · Exp.'}] : []} only %}
{% if format.depth == 2 %}<p>Un clic sur un système ouvre ses trois sous-niveaux. <a href="#reperes">Voir les neuf coordonnées</a>.</p>{% endif %}</section>
{% for point in example.levels %}{% include 'analysis/_point.html.twig' with {point:point} only %}{% if format.depth == 2 %}<p><a class="primary-link" href="{{ path('analysis_example_level',{slug:example.slug,base:point.id}) }}">Ouvrir {{ point.id }}.1 → {{ point.id }}.2 → {{ point.id }}.3</a></p>{% endif %}{% endfor %}
{% if format.depth == 2 %}<section class="analysis-matrix" id="reperes"><h2>Les neuf sous-niveaux</h2><div class="format-coordinate-grid">{% for level in example.levels %}<div><h3>{{ level.coordinate }} · {{ level.title }}</h3><ul>{% for step in level.steps %}<li><a href="{{ path('analysis_example_level',{slug:example.slug,base:level.id,_fragment:'point-' ~ step.coordinate}) }}">{{ step.coordinate }} · {{ step.title }}</a></li>{% endfor %}</ul></div>{% endfor %}</div></section>{% endif %}
<section class="analysis-review" id="comparaisons" data-analysis-review><h2>Contrôle et limites</h2>{% include 'science/_analysis-evaluation.html.twig' with {evaluation:example.review} only %}</section>
<section class="external-selection"><h2>Approfondir ce sujet</h2><p><a href="{{ path('learning_card',{slug:example.reading_card}) }}">Lire la fiche complète, ses références et son analyse 6 × 6</a>. Cette autre forme approfondit le sujet avec son propre périmètre.</p>{% if example.references|default([]) %}<ul>{% for ref in example.references %}<li><a href="{{ ref.url }}" rel="noopener noreferrer">{{ ref.title }}</a> — {{ ref.note }}</li>{% endfor %}</ul>{% endif %}</section>
<nav class="analysis-footer"><a href="{{ path('analysis_format',{format:format.id,_fragment:'exemples'}) }}">Tous les exemples de ce cas</a><a href="{{ path('sitephys_physmvc_home') }}">Choisir une autre forme</a></nav>
{% endblock %}
