{% extends 'site/layout.html.twig' %}
{% block title %}{{ base }} · {{ parent.title }} — Sous-boucle{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('sitephys_physmvc_home', {_fragment: 'etape-' ~ base}) }}">La boucle générale</a> / {{ base }} · {{ parent.title }}</nav>
<header class="page-heading"><p class="eyebrow">Thermodynamique et physique statistique · Niveau de base {{ base }}</p><h1>{{ parent.title }}, en six sous-étapes</h1><p class="lead">{{ parent.text }}</p><p>Le premier chiffre repère l’étape générale, le second précise le chemin à l’intérieur de cette étape. Ces coordonnées décrivent la méthode ; le niveau d’étude figure sur chaque fiche.</p></header>
<nav class="base-switcher" aria-label="Changer d’étape générale">{% for item in parents %}<a href="{{ path('learning_subloop', {base: item.id}) }}"{% if item.id == base %} aria-current="page"{% endif %}>{{ item.id }} · {{ item.title }}</a>{% endfor %}</nav>
<section class="interactive-loop precision-loop" aria-labelledby="boucle-titre"><h2 id="boucle-titre">La sous-boucle {{ base }}</h2>
{% include 'site/_loop.html.twig' with {tip_prefix: 'precision-tip-' ~ base ~ '-', anchor_prefix: 'precision-' ~ base ~ '.', marker_id: 'precision-arrow-' ~ base, board_label: 'Sous-boucle ' ~ base ~ ' : ' ~ parent.title} %}
<p class="loop-help">Clic : rejoindre la sous-étape. Survol ou Tab : lire l’explication. Sur mobile : bouton « i ». Le lien de lecture rejoint le passage utile d’une fiche.</p></section>
{% for step in steps %}<section class="guide-step tone-{{ step.color }}" id="precision-{{ step.coordinate }}" tabindex="-1"><div class="guide-step-heading"><span class="step-number">{{ step.coordinate }}</span><div><p class="eyebrow">{{ step.subtitle }}</p><h2>{{ step.title }}</h2></div></div><p>{{ step.text }}</p><p class="deliverable"><strong>À conserver :</strong> {{ step.deliverable }}</p><a class="primary-link" href="{{ path('learning_card', {slug: step.card, _fragment: step.section}) }}">Lire : {{ step.card_title }}</a><div class="step-actions"><a href="#boucle-titre">Revenir au schéma</a>{% if step.id < 6 %}<a href="#precision-{{ base }}.{{ step.id + 1 }}">Sous-étape suivante →</a>{% else %}<a href="{{ path('learning_subloop', {base: base == 6 ? 1 : base + 1}) }}">{{ base == 6 ? 'Recommencer la boucle →' : 'Passer à l’étape générale suivante →' }}</a>{% endif %}</div></section>{% endfor %}
<details class="loop-overview"><summary>Vue d’ensemble des 36 sous-étapes</summary><div class="subloop-overview">{% for group in subloops %}<section><h3>{{ group.base }} · {{ parents[group.base - 1].title }}</h3><ol>{% for item in group.steps %}<li><a href="{{ path('learning_subloop', {base: group.base, _fragment: 'precision-' ~ item.coordinate}) }}">{{ item.coordinate }} · {{ item.title }}</a></li>{% endfor %}</ol></section>{% endfor %}</div></details>
{% endblock %}
