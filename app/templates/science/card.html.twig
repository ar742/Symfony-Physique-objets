{% extends 'site/layout.html.twig' %}
{% block title %}{{ card.title }} — Physique objets{% endblock %}
{% block body %}
<nav class="breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('learning_domains') }}">Domaines</a> / <a href="{{ path('learning_domain', {slug: domain.slug}) }}">{{ domain.title }}</a> / {{ '%02d'|format(card.number) }}</nav>
<header class="page-heading"><p class="eyebrow">Fiche {{ '%02d'|format(card.number) }} · {{ card.level }}</p><h1>{{ card.title }}</h1><p class="lead">{{ card.summary }}</p><p class="pilot-status">{{ card.status }} · v{{ card.version }} · {{ card.updated|date('d/m/Y') }}</p></header>
<div class="reading-layout">
    <nav class="contents" aria-label="Sommaire de la fiche"><p>Dans cette fiche</p><a href="#conditions">Cadre et hypothèses</a>{% for section in card.sections %}<a href="#{{ section.id }}">{{ section.title }}</a>{% endfor %}<a href="#exemple">Exemple calculé</a><a href="#controle">Se vérifier</a>{% if card.corrections %}<a href="#corrections">Corrections</a>{% endif %}<a href="#sources">Sources</a><a href="#dans-la-boucle">Dans la boucle</a></nav>
    <article class="reading-content learning-article">
        <section class="reading-section" id="conditions" tabindex="-1"><h2>Cadre et hypothèses</h2><p><strong>Objectif :</strong> {{ card.objective }}</p><p><strong>Prérequis :</strong> {{ card.prerequisites|join(' · ') }}.</p><p><strong>Système :</strong> {{ card.system }}</p><ul>{% for condition in card.conditions %}<li>{{ condition }}</li>{% endfor %}</ul></section>
        {% for section in card.sections %}<section class="reading-section" id="{{ section.id }}" tabindex="-1"><h2>{{ section.title }}</h2>{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}{% for equation in section.equations %}<figure class="equation"><div class="math-scroll">{% include 'science/equations/' ~ equation.id ~ '.html.twig' %}</div><figcaption>{{ equation.reading }}</figcaption></figure>{% endfor %}</section>{% endfor %}
        <section class="reading-section" id="exemple" tabindex="-1"><p class="eyebrow">Application numérique · valeurs calculées</p><h2>Un exemple pour fixer les idées</h2><p>{{ card.example.question }}</p><ol>{% for line in card.example.steps %}<li>{{ line }}</li>{% endfor %}</ol><p class="example-result">{{ card.example.result }}</p></section>
        <section class="reading-section" id="controle" tabindex="-1"><h2>Se vérifier</h2><p>{{ card.checkpoint.question }}</p><details class="answer"><summary>Afficher la réponse expliquée</summary><p>{{ card.checkpoint.answer }}</p></details></section>
        {% if card.corrections %}<section class="reading-section" id="corrections" tabindex="-1"><h2>Corrections et précisions</h2>{% for correction in card.corrections %}<div class="correction" id="{{ correction.id }}"><h3>{{ correction.id }} · {{ correction.title }}</h3><p>{{ correction.detail }}</p>{% include 'science/_sources.html.twig' with {sources: correction.sources} only %}</div>{% endfor %}<a href="{{ path('learning_corrections') }}">Voir le journal complet</a></section>{% endif %}
        <section class="reading-section" id="sources" tabindex="-1"><h2>Sources et traçabilité</h2><p>Reformulation des passages suivants des recueils d’Aurélien Roudier, avec les précisions signalées ci-dessus. Les exemples ont été recalculés pour cette version web.</p>{% include 'science/_sources.html.twig' with {sources: card.sources} only %}<h3>Vérifications et compléments externes</h3><ul class="precise-sources">{% for reference in card.references %}<li><a href="{{ reference.url }}" rel="noopener noreferrer">{{ reference.title }}</a><span>{{ reference.note }}</span></li>{% endfor %}</ul></section>
        <section class="reading-section" id="dans-la-boucle" tabindex="-1"><h2>Retrouver cette fiche dans la boucle</h2><ul class="loop-locations">{% for location in locations %}<li><a href="{{ path('learning_subloop', {base: location.base, _fragment: 'precision-' ~ location.coordinate}) }}">{{ location.coordinate }} · {{ location.title }}</a></li>{% endfor %}{% for location in domain_locations %}<li><a href="{{ path('learning_domain', {slug: domain.slug, _fragment: 'boucle-domaine'}) }}">{{ location.id }} · {{ location.title }} ({{ domain.title }})</a></li>{% endfor %}</ul></section>
        <nav class="card-pagination" aria-label="Parcours de lecture">{% if previous %}<a href="{{ path('learning_card', {slug: previous.slug}) }}"><span>Fiche précédente</span>{{ previous.title }}</a>{% endif %}{% if next %}<a href="{{ path('learning_card', {slug: next.slug}) }}"><span>Fiche suivante</span>{{ next.title }}</a>{% else %}<a href="{{ path('learning_index') }}">Revenir au parcours</a>{% endif %}</nav>
    </article>
</div>
{% endblock %}
